/* ============================================================
   CSS VARIABLES — Design Tokens (extraídos do Figma)
   ============================================================ */
:root {
  /* Paleta */
  --color-bg: #f5ebdc; /* Quarter Spanish White */
  --color-title: #502314; /* Brown Derby */
  --color-subtitle: rgba(80, 35, 20, 0.7); /* Brown Derby 70% */
  --color-white: #ffffff;
  --color-white-80: rgba(255, 255, 255, 0.8);

  /* Gradientes dos cards */
  --grad-red: linear-gradient(
    127.22deg,
    rgb(220, 38, 38) 0%,
    rgb(153, 27, 27) 100%
  );
  --grad-brown: linear-gradient(
    127.22deg,
    rgb(217, 119, 6) 0%,
    rgb(146, 64, 14) 100%
  );
  --grad-yellow: linear-gradient(
    127.22deg,
    rgb(234, 179, 8) 0%,
    rgb(161, 98, 7) 100%
  );
  --grad-amber: linear-gradient(
    127.22deg,
    rgb(251, 191, 36) 0%,
    rgb(217, 119, 6) 100%
  );
  --grad-green: linear-gradient(
    127.22deg,
    rgb(34, 197, 94) 0%,
    rgb(21, 128, 61) 100%
  );
  --grad-crimson: linear-gradient(
    127.22deg,
    rgb(239, 68, 68) 0%,
    rgb(214, 35, 0) 100%
  );

  /* Tipografia */
  --font-display: "Titan One", sans-serif;
  --font-body: "Open Sans", sans-serif;
}

/* ============================================================
   RESET
   ============================================================ */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ============================================================
   BASE
   ============================================================ */
body {
  background-color: var(--color-bg);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

/* ============================================================
   SEÇÃO
   ============================================================ */
.ingredients-section {
  background-color: var(--color-bg);
  width: 100%;
  padding: 96px 40px; /* top igual ao frame Figma */
  height: 652px;
}

/* ============================================================
   CONTAINER INTERNO
   ============================================================ */
.ingredients-container {
  max-width: 1094px; /* largura real do frame no Figma */
  margin: 0 auto;
  text-align: center;
}

/* ============================================================
   TÍTULO
   ============================================================ */
.ingredients-title {
  font-family: var(--font-display);
  font-size: 72px;
  line-height: 1;
  color: var(--color-title);
  text-transform: uppercase;
  letter-spacing: 0;
  margin-bottom: 24px;
}

/* ============================================================
   SUBTÍTULO
   ============================================================ */
.ingredients-subtitle {
  font-family: var(--font-body);
  font-size: 20px;
  line-height: 28px;
  font-weight: 400;
  color: var(--color-subtitle);
  max-width: 645px;
  margin: 0 auto 80px; /* espaço até os cards conforme Figma */
}

/* ============================================================
   CARDS WRAPPER
   ============================================================ */
.cards-wrapper {
  display: flex;
  justify-content: center;
  gap: 24px;
  flex-wrap: nowrap;
}

/* ============================================================
   CARD — BASE
   ============================================================ */
.card {
  position: relative;
  width: 185.33px;
  min-height: 244px;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end; /* textos na base */
  padding-bottom: 24px;
  flex-shrink: 0;
  text-align: center;
  opacity: 0;
}

/* ============================================================
   ÍCONE / IMAGEM DO INGREDIENTE
   ============================================================ */
.card__icon {
  position: absolute;
  top: 41.99px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  /* sem sombra ou borda */
}

/* ============================================================
   CORPO DO CARD (nome + descrição)
   ============================================================ */
.card__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

/* Nome */
.card__name {
  font-family: var(--font-display);
  font-size: 20px;
  line-height: 28px;
  font-weight: 200;
  color: var(--color-white);
}

/* Descrição */
.card__desc {
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 20px;
  font-weight: 400;
  color: var(--color-white-80);
  margin-top: auto;
  margin-bottom: 10px;
}

/* ============================================================
   MODIFICADORES DE COR — GRADIENTES (extraídos do Figma)
   ============================================================ */
.card--red {
  background: var(--grad-red);
}
.card--brown {
  background: var(--grad-brown);
}
.card--yellow {
  background: var(--grad-yellow);
}
.card--amber {
  background: var(--grad-amber);
}
.card--green {
  background: var(--grad-green);
}
.card--crimson {
  background: var(--grad-crimson);
}

/* ============================================================
   RESPONSIVIDADE
   ============================================================ */

/* Laptop/Tablet largo: título encolhe */
@media (max-width: 960px) {
  .ingredients-title {
    font-size: 52px;
  }

  .ingredients-subtitle {
    font-size: 18px;
  }

  .card {
    width: 130px;
    min-height: 200px;
  }

  .card__icon {
    width: 64px;
    height: 64px;
    top: 18px;
  }

  .card__name {
    font-size: 17px;
  }
}

/* Tablet: 2 linhas de 3 cards */
@media (max-width: 720px) {
  .ingredients-section {
    padding: 64px 24px;
  }

  .ingredients-title {
    font-size: 40px;
  }

  .ingredients-subtitle {
    font-size: 16px;
    margin-bottom: 48px;
  }

  .cards-wrapper {
    flex-wrap: wrap;
    gap: 16px;
  }

  .card {
    width: calc(33.333% - 12px);
    min-width: 100px;
    max-width: 160px;
  }
}

/* Mobile: 2 colunas */
@media (max-width: 480px) {
  .ingredients-section {
    padding: 48px 16px;
  }

  .ingredients-title {
    font-size: 30px;
  }

  .ingredients-subtitle {
    font-size: 14px;
    margin-bottom: 36px;
  }

  .cards-wrapper {
    gap: 12px;
  }

  .card {
    width: calc(50% - 6px);
    min-width: 0;
    max-width: none;
  }

  .card__icon {
    width: 52px;
    height: 52px;
    top: 16px;
  }

  .card__name {
    font-size: 15px;
    line-height: 22px;
  }

  .card__desc {

/* ============================================================
   TRANSIÇÕES — Scroll-Triggered Entrance
   ============================================================ */

/* === Title: Slide Up + Fade === */
.ingredients-title {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: 0s;
}

.ingredients-section.is-visible .ingredients-title {
  opacity: 1;
  transform: translateY(0);
}

/* === Subtitle: Slide Up + Fade + Slight Delay === */
.ingredients-subtitle {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: 0.15s;
}

.ingredients-section.is-visible .ingredients-subtitle {
  opacity: 1;
  transform: translateY(0);
}

/* === Cards: Slide In from Right + Staggered Delay === */
.card {
  opacity: 0;
  transform: translateX(60px);
  transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: calc(var(--i) * 0.2s);
}

.cards-wrapper.is-visible .card {
  opacity: 1;
  transform: translateX(0);
}

/* ============================================================
   HOVER EFFECT — Zoom + Shimmer
   ============================================================ */

.card:hover {
  transform: scale(1.05);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
}

.card::after {
  content: '';
  position: absolute;
  top: 0;
  left: -75%;
  width: 50%;
  height: 100%;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.35) 50%, rgba(255, 255, 255, 0) 100%);
  transform: skewX(-20deg);
  transition: left 0s;
  pointer-events: none;
}

.card:hover::after {
  left: 130%;
  transition: left 0.55s ease;
}

/* ============================================================
   ACESSIBILIDADE
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .ingredients-title, .ingredients-subtitle, .card {
    opacity: 1;
    transform: none !important;
    transition: none;
  }
  .card:hover {
    transform: none;
    box-shadow: none;
  }
}
